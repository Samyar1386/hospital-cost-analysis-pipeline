        "text": "=Analytical question: {{ $json.question }}\n\nKPI data:\n{{ JSON.stringify($json, null, 2) }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a report writer. Write in English, using Western digits (0-9) only.\nRules:\n- Use ONLY the numbers provided. Never calculate, round, estimate or invent a value.\n- Copy each number exactly as given.\n- Report every provided KPI; do not decide what is important.\n- State the significance verdict exactly as provided. Do not strengthen or weaken it.\n- Do not use numbered lists. Plain paragraphs and short bullets only.\n- Structure: Summary, Key Metrics, Main Finding, Practical Implication.\n- Maximum 200 words."
            }
          ]
        },
