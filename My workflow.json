    {
      "parameters": {
        "jsCode": "const report = $input.first().json.text || \"\";\nconst data = $('Edit Fields').first().json;\n\n// استخراج اعداد مجاز از ورودی اکسل\nconst allowed = Object.entries(data)\n  .filter(([k, v]) => k !== 'question' && v !== '' && v !== null && !isNaN(Number(v)))\n  .map(([k, v]) => Number(v));\n\n// استخراج تمام اعداد موجود در متن گزارش\nconst found = (report.replace(/,/g, '').match(/\\d+(\\.\\d+)?/g) || []).map(Number);\n\n// پیدا کردن اعدادی که در گزارش آمده اما در اکسل نبوده\nconst extra = found.filter(n => !allowed.some(a => Math.abs(a - n) < 0.01));\n\n// پیدا کردن اعدادی که در اکسل بوده اما در گزارش ذکر نشده\nconst missing = allowed.filter(a => !found.some(n => Math.abs(a - n) < 0.01));\n\nreturn [{\n  json: {\n    report,\n    valid: extra.length === 0 && missing.length === 0,\n    extra,\n    missing\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
